--- /dev/null
+++ b/src/web/game-index.ts
@@ -0,0 +1,28 @@
+export interface GameIndex {
+    version: 1;
+    key: string;
+    files: [string, number][];
+}
+export interface Lookup {
+    find(rel: string): number | undefined;
+    list(dir: string): string[] | null;
+}
+const norm = (p: string) => p.replace(/\\/g, '/').replace(/^\/+|\/+$/g, '').toLowerCase();
+export function buildLookup(files: [string, number][]): Lookup {
+    const byLower = new Map<string, number>();
+    const dirs = new Map<string, Map<string, string>>();
+    files.forEach(([path], i) => {
+        byLower.set(path.toLowerCase(), i);
+        const parts = path.split('/');
+        for (let d = 0; d < parts.length; d++) {
+            const parent = parts.slice(0, d).join('/').toLowerCase();
+            let m = dirs.get(parent);
+            if (!m) dirs.set(parent, (m = new Map()));
+            m.set(parts[d]!.toLowerCase(), parts[d]!);
+        }
+    });
+    return {
+        find: rel => byLower.get(norm(rel)),
+        list: dir => { const m = dirs.get(norm(dir)); return m ? [...m.values()] : null; },
+    };
+}

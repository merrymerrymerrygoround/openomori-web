@@ -0,0 +1,22 @@
+const DB = 'omori-mods';
+const DB_VERSION = 3;
+function open(): Promise<IDBDatabase> {
+    return new Promise((res, rej) => {
+        const r = indexedDB.open(DB, DB_VERSION);
+        r.onupgradeneeded = () => {
+            const db = r.result;
+            for (const [name, opts] of [['mods', { keyPath: 'key' }], ['profiles', { keyPath: 'id' }], ['backups', { keyPath: 'id' }], ['meta', undefined], ['gen', undefined], ['olidcache', undefined]] as const) {
+                if (!db.objectStoreNames.contains(name)) db.createObjectStore(name, opts);
+            }
+        };
+        r.onsuccess = () => res(r.result);
+        r.onerror = () => rej(r.error ?? new Error('cannot open the browser database (private browsing?)'));
+    });
+}
+const done = <T>(r: IDBRequest<T>) => new Promise<T>((res, rej) => { r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error); });
+async function tx<T>(store: string, mode: IDBTransactionMode, fn: (s: IDBObjectStore) => IDBRequest<T>): Promise<T> {
+    const db = await open();
+    try { return await done(fn(db.transaction(store, mode).objectStore(store))); } finally { db.close(); }
+}
+export const getMeta = <T>(key: string) => tx('meta', 'readonly', s => s.get(key)) as Promise<T | undefined>;
+export const setMeta = (key: string, value: unknown) => tx('meta', 'readwrite', s => s.put(value, key));
diff --git a/src/web/import-worker.ts b/src/web/import-worker.ts
new file mode 100644
index 0000000..6b2925d
--- /dev/null
+++ b/src/web/import-worker.ts
@@ -0,0 +1,53 @@
+import { extractKey, findGameRoot, openEntry, readCentralDirectory, readEntry } from './zip.ts';
+const post = (m: unknown) => (self as unknown as Worker).postMessage(m);
+self.onmessage = async (e: MessageEvent<{ file: File }>) => {
+    try { await run(e.data.file); } catch (err) { post({ type: 'error', message: err instanceof Error ? err.message : String(err) }); }
+};
+function writeAll(h: any, data: Uint8Array, at: number): number {
+    let done = 0;
+    while (done < data.byteLength) {
+        const n = h.write(data.subarray(done), { at: at + done });
+        if (!n) throw new Error('The browser stopped accepting data (out of storage?).');
+        done += n;
+    }
+    return at + done;
+}
+async function run(file: File): Promise<void> {
+    const entries = await readCentralDirectory(file);
+    const found = findGameRoot(entries.map(x => x.name));
+    if (!found) throw new Error('This zip does not look like an OMORI folder: it has no www/js/rpg_core.js. Zip the folder that contains OMORI.exe and www.');
+    let key: string | null = null;
+    const bat = found.root === null ? undefined : entries.find(x => x.name.toLowerCase() === found.root + 'launch_omori.bat');
+    if (bat) key = extractKey(new TextDecoder().decode(await readEntry(file, bat)));
+    const files = entries.filter(x => !x.name.endsWith('/') && x.name.toLowerCase().startsWith(found.prefix));
+    const total = files.reduce((n, x) => n + x.usize, 0);
+    const est = await navigator.storage.estimate?.();
+    if (est?.quota && est.usage !== undefined && total > est.quota - est.usage) {
+        throw new Error(`Not enough free browser storage: the game needs ${(total / 2 ** 30).toFixed(1)} GB and about ${((est.quota - est.usage) / 2 ** 30).toFixed(1)} GB is available.`);
+    }
+    const root = await navigator.storage.getDirectory();
+    await root.removeEntry('game', { recursive: true }).catch(() => {});
+    const dir = await root.getDirectoryHandle('game', { create: true });
+    const index: [string, number][] = [];
+    let bytes = 0, lastPost = 0;
+    for (let i = 0; i < files.length; i++) {
+        const en = files[i]!;
+        const handle = await (await dir.getFileHandle(String(i), { create: true }) as any).createSyncAccessHandle();
+        let at = 0;
+        try {
+            const reader = (await openEntry(file, en)).getReader();
+            for (;;) {
+                const { done, value } = await reader.read();
+                if (done) break;
+                at = writeAll(handle, value, at);
+            }
+            handle.flush();
+        } finally { handle.close(); }
+        if (at !== en.usize) throw new Error(`Corrupt zip entry (size mismatch): ${en.name}`);
+        index.push([en.name.slice(found.prefix.length), at]);
+        bytes += at;
+        const now = Date.now();
+        if (now - lastPost > 150) { lastPost = now; post({ type: 'progress', files: i + 1, totalFiles: files.length, bytes, totalBytes: total }); }
+    }
+    post({ type: 'done', key, files: index });
+}

new file mode 100644
index 0000000..ba5c0f9
--- /dev/null
+++ b/src/web/zip.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, test } from 'bun:test';
+import { zipSync } from 'fflate';
+import { buildLookup } from './game-index.ts';
+import { extractKey, findGameRoot, readCentralDirectory, readEntry } from './zip.ts';
+const enc = (s: string) => new TextEncoder().encode(s);
+const KEY = '0123456789abcdef0123456789abcdef';
+const sample = () => zipSync({
+    'OMORI/Launch_OMORI.bat': [enc(`start nw.exe . --${KEY}`), { level: 0 }],
+    'OMORI/OMORI.exe': [enc('MZ'), { level: 0 }],
+    'OMORI/www/js/rpg_core.js': [enc('// core '.repeat(200)), { level: 6 }],
+    'OMORI/www/Languages/en/1.HERO': [enc('hello'), { level: 0 }],
+    'OMORI/www/img/pictures/a%b.rpgmvp': [new Uint8Array([1, 2, 3]), { level: 0 }],
+});
+describe('zip reader', () => {
+    test('lists entries and reads stored and deflated data', async () => {
+        const file = new Blob([sample()]);
+        const entries = await readCentralDirectory(file);
+        expect(entries.map(e => e.name).sort()).toContain('OMORI/www/js/rpg_core.js');
+        const core = entries.find(e => e.name.endsWith('rpg_core.js'))!;
+        if (typeof DecompressionStream !== 'undefined') expect(new TextDecoder().decode(await readEntry(file, core))).toBe('// core '.repeat(200));
+        const bat = entries.find(e => e.name.endsWith('.bat'))!;
+        expect(extractKey(new TextDecoder().decode(await readEntry(file, bat)))).toBe(KEY);
+    });
+    test('finds the game inside a wrapping folder, or www on its own', () => {
+        expect(findGameRoot(['OMORI/www/js/rpg_core.js', 'OMORI/OMORI.exe'])).toEqual({ prefix: 'omori/www/', root: 'omori/' });
+        expect(findGameRoot(['js/rpg_core.js', 'data/System.KEL'])).toEqual({ prefix: '', root: null });
+        expect(findGameRoot(['www/js/rpg_core.js.bak', 'readme.txt'])).toBeNull();
+    });
+    test('rejects things that are not zips', async () => {
+        await expect(readCentralDirectory(new Blob([enc('not a zip file at all, just some text here')]))).rejects.toThrow();
+    });
+});
+describe('game index', () => {
+    const files: [string, number][] = [['Languages/en/1.HERO', 5], ['js/rpg_core.js', 9], ['img/a%b.rpgmvp', 3]];
+    const lookup = buildLookup(files);
+    test('matches paths case-insensitively', () => {
+        expect(lookup.find('languages/EN/1.hero')).toBe(0);
+        expect(lookup.find('/js/rpg_core.js')).toBe(1);
+        expect(lookup.find('img/a%b.rpgmvp')).toBe(2);
+        expect(lookup.find('nope')).toBeUndefined();
+    });
+    test('lists folders with their real names', () => {
+        expect(lookup.list('')!.sort()).toEqual(['Languages', 'img', 'js']);
+        expect(lookup.list('languages')).toEqual(['en']);
+        expect(lookup.list('js/rpg_core.js')).toBeNull();
+    });
+});
diff --git a/src/web/zip.ts b/src/web/zip.ts
new file mode 100644
index 0000000..26ae38e
--- /dev/null
+++ b/src/web/zip.ts
@@ -0,0 +1,77 @@
+export interface ZipEntry {
+    name: string;
+    method: number;
+    csize: number;
+    usize: number;
+    offset: number;
+}
+const SIG_EOCD = 0x06054b50, SIG_EOCD64 = 0x06064b50, SIG_LOC64 = 0x07064b50, SIG_CEN = 0x02014b50, SIG_LOCAL = 0x04034b50;
+const u16 = (v: DataView, o: number) => v.getUint16(o, true);
+const u32 = (v: DataView, o: number) => v.getUint32(o, true);
+const u64 = (v: DataView, o: number) => Number(v.getBigUint64(o, true));
+const view = (b: ArrayBuffer) => new DataView(b);
+export async function readCentralDirectory(file: Blob): Promise<ZipEntry[]> {
+    const size = file.size;
+    if (size < 22) throw new Error('That file is too small to be a zip.');
+    const tailStart = Math.max(0, size - (0xffff + 22));
+    const tail = view(await file.slice(tailStart, size).arrayBuffer());
+    let eocd = -1;
+    for (let i = tail.byteLength - 22; i >= 0; i--) if (u32(tail, i) === SIG_EOCD) { eocd = i; break; }
+    if (eocd < 0) throw new Error('That does not look like a zip file (no end-of-archive record).');
+    let count = u16(tail, eocd + 10), cdSize = u32(tail, eocd + 12), cdOffset = u32(tail, eocd + 16);
+    if (count === 0xffff || cdSize === 0xffffffff || cdOffset === 0xffffffff) {
+        const loc = eocd - 20;
+        if (loc < 0 || u32(tail, loc) !== SIG_LOC64) throw new Error('Zip64 archive without a Zip64 locator.');
+        const z64 = view(await file.slice(u64(tail, loc + 8), u64(tail, loc + 8) + 56).arrayBuffer());
+        if (u32(z64, 0) !== SIG_EOCD64) throw new Error('Corrupt Zip64 end-of-archive record.');
+        count = u64(z64, 32); cdSize = u64(z64, 40); cdOffset = u64(z64, 48);
+    }
+    const buf = await file.slice(cdOffset, cdOffset + cdSize).arrayBuffer();
+    const cd = view(buf), bytes = new Uint8Array(buf), dec = new TextDecoder();
+    const out: ZipEntry[] = [];
+    let o = 0;
+    while (o + 46 <= cd.byteLength && u32(cd, o) === SIG_CEN) {
+        const method = u16(cd, o + 10);
+        let csize = u32(cd, o + 20), usize = u32(cd, o + 24), offset = u32(cd, o + 42);
+        const nlen = u16(cd, o + 28), elen = u16(cd, o + 30), clen = u16(cd, o + 32);
+        const name = dec.decode(bytes.subarray(o + 46, o + 46 + nlen));
+        for (let e = o + 46 + nlen, end = e + elen; e + 4 <= end;) {
+            const id = u16(cd, e), len = u16(cd, e + 2);
+            if (id === 1) {
+                let p = e + 4;
+                if (usize === 0xffffffff) { usize = u64(cd, p); p += 8; }
+                if (csize === 0xffffffff) { csize = u64(cd, p); p += 8; }
+                if (offset === 0xffffffff) { offset = u64(cd, p); p += 8; }
+            }
+            e += 4 + len;
+        }
+        out.push({ name, method, csize, usize, offset });
+        o += 46 + nlen + elen + clen;
+    }
+    if (out.length !== count) throw new Error(`Zip directory is damaged (expected ${count} entries, read ${out.length}).`);
+    return out;
+}
+export async function openEntry(file: Blob, e: ZipEntry): Promise<ReadableStream<Uint8Array>> {
+    const head = view(await file.slice(e.offset, e.offset + 30).arrayBuffer());
+    if (head.byteLength < 30 || u32(head, 0) !== SIG_LOCAL) throw new Error(`Corrupt zip entry: ${e.name}`);
+    const start = e.offset + 30 + u16(head, 26) + u16(head, 28);
+    const raw = file.slice(start, start + e.csize).stream() as ReadableStream<Uint8Array>;
+    if (e.method === 0) return raw;
+    if (e.method === 8) return raw.pipeThrough(new DecompressionStream('deflate-raw') as unknown as ReadableWritablePair<Uint8Array, Uint8Array>);
+    throw new Error(`Unsupported compression method ${e.method} for ${e.name}`);
+}
+export async function readEntry(file: Blob, e: ZipEntry): Promise<Uint8Array> {
+    return new Uint8Array(await new Response(await openEntry(file, e)).arrayBuffer());
+}
+export function findGameRoot(names: string[]): { prefix: string; root: string | null } | null {
+    for (const marker of ['www/js/rpg_core.js', 'js/rpg_core.js']) {
+        for (const n of names) {
+            const l = n.toLowerCase();
+            const i = l.lastIndexOf(marker);
+            if (i < 0 || l.length !== i + marker.length || (i > 0 && l[i - 1] !== '/')) continue;
+            return marker.startsWith('www/') ? { prefix: l.slice(0, i) + 'www/', root: l.slice(0, i) } : { prefix: l.slice(0, i), root: null };
+        }
+    }
+    return null;
+}
+export const extractKey = (text: string): string | null => /--([0-9a-f]{32})/i.exec(text)?.[1]?.toLowerCase() ?? null;

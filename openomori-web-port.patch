+import { BASE } from './base.ts';
+export async function runDiagnostics(): Promise<string> {
+    const lines: string[] = [];
+    const add = (k: string, v: unknown) => lines.push(`${k}: ${typeof v === 'string' ? v : JSON.stringify(v)}`);
+    const safe = async <T>(f: () => Promise<T>): Promise<T | string> => { try { return await f(); } catch (e) { return 'threw ' + String(e); } };
+    add('page', location.href);
+    add('browser', navigator.userAgent);
+    add('service worker controls page', !!navigator.serviceWorker?.controller);
+    add('registration', await safe(async () => { const r = await navigator.serviceWorker.getRegistration(BASE); return r ? { scope: r.scope, active: !!r.active } : null; }));
+    add('storage estimate', await safe(async () => navigator.storage.estimate()));
+    add('storage persisted', await safe(async () => navigator.storage.persisted()));
+    add('page can read game storage', await safe(async () => {
+        const dir = await (await navigator.storage.getDirectory()).getDirectoryHandle('game');
+        return { firstFileBytes: (await (await dir.getFileHandle('0')).getFile()).size };
+    }));
+    for (const p of ['__diag', '__config', '__ls?p=data', 'js/rpg_core.js', 'data/System.KEL', '__failures']) {
+        add('GET ' + p, await safe(async () => {
+            const r = await fetch(BASE + p, { cache: 'no-store' });
+            if (p === '__config') return `${r.status} ${r.ok && 'key' in (await r.json()) ? 'key present' : 'no key'}`;
+            if (p === '__failures') return `${r.status} ${(await r.text())}`;
+            if (p.endsWith('.js') || p.endsWith('.KEL')) return `${r.status} ${r.ok ? (await r.arrayBuffer()).byteLength + ' bytes' : (await r.text()).slice(0, 200)}`;
+            return `${r.status} ${(await r.text()).slice(0, 300)}`;
+        }));
+    }
+    return lines.join('\n');
+}

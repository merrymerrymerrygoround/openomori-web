+++ b/src/web/game-sw.ts
@@ -0,0 +1,120 @@
+import { getMeta } from './idb.ts';
+import { buildLookup, type GameIndex, type Lookup } from './game-index.ts';
+const scope = () => new URL((self as any).registration.scope).pathname;
+export function relPath(url: URL): string {
+    let p: string;
+    try { p = decodeURIComponent(url.pathname); } catch { p = url.pathname; }
+    const base = scope();
+    return p.startsWith(base) ? p.slice(base.length) : p.replace(/^\/+/, '');
+}
+export const isAppAsset = (rel: string) =>
+    rel === '' || rel === 'index.html' || rel === 'app.js' || rel === 'app.js.map' || rel === 'sw.js' || rel === 'import-worker.js' || rel === 'file-provider.js' || rel.startsWith('vendor/');
+interface Loaded { key: string; lookup: Lookup; count: number }
+let loaded: Promise<Loaded | null> | null = null;
+let gameDir: Promise<FileSystemDirectoryHandle> | null = null;
+export function dropGame(): void { loaded = null; gameDir = null; }
+const load = () => {
+    if (loaded) return loaded;
+    const p = (async () => {
+        const g = await getMeta<GameIndex>('webGame');
+        return g?.key ? { key: g.key, lookup: buildLookup(g.files), count: g.files.length } : null;
+    })();
+    loaded = p;
+    p.then(v => { if (!v && loaded === p) loaded = null; }, () => { if (loaded === p) loaded = null; });
+    return p;
+};
+const failures = new Map<string, string>();
+function fail(rel: string, why: string): void {
+    failures.delete(rel);
+    failures.set(rel, why);
+    if (failures.size > 40) failures.delete(failures.keys().next().value!);
+}
+const MIME: Record<string, string> = {
+    png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif', webp: 'image/webp', ogg: 'audio/ogg', m4a: 'audio/mp4', mp3: 'audio/mpeg', wav: 'audio/wav',
+    webm: 'video/webm', mp4: 'video/mp4', ttf: 'font/ttf', otf: 'font/otf', woff: 'font/woff', woff2: 'font/woff2', js: 'text/javascript', json: 'application/json',
+    css: 'text/css', html: 'text/html', txt: 'text/plain', yml: 'text/plain', yaml: 'text/plain', md: 'text/plain',
+};
+const chan = typeof BroadcastChannel === 'undefined' ? null : new BroadcastChannel('omori-game-files');
+const pending = new Map<number, (m: { file: File | null; error?: string }) => void>();
+let nextId = 1;
+let directError: string | null = null;
+if (chan) chan.onmessage = e => { const m = e.data; if (m?.type === 'file') { pending.get(m.id)?.(m); pending.delete(m.id); } };
+const within = <T>(p: Promise<T>, ms: number, what: string): Promise<T> =>
+    new Promise<T>((resolve, reject) => { const t = setTimeout(() => reject(new Error(what + ' timed out')), ms); p.then(v => { clearTimeout(t); resolve(v); }, e => { clearTimeout(t); reject(e); }); });
+async function direct(i: number): Promise<File> {
+    return within((async () => {
+        const dir = await (gameDir ??= navigator.storage.getDirectory().then(r => r.getDirectoryHandle('game')));
+        return (await dir.getFileHandle(String(i))).getFile();
+    })(), 3000, 'opening game storage');
+}
+const LIMIT = 6;
+let active = 0;
+const waiting: (() => void)[] = [];
+async function slot<T>(f: () => Promise<T>): Promise<T> {
+    if (active >= LIMIT) await new Promise<void>(res => waiting.push(res));
+    active++;
+    try { return await f(); } finally { active--; waiting.shift()?.(); }
+}
+async function viaProvider(i: number): Promise<File> {
+    let last: unknown;
+    for (let attempt = 0; attempt < 3; attempt++) {
+        try { return await slot(() => askProvider(i)); } catch (e) { last = e; }
+    }
+    throw last;
+}
+function askProvider(i: number): Promise<File> {
+    return new Promise((resolve, reject) => {
+        if (!chan) return reject(new Error('no BroadcastChannel'));
+        const id = nextId++;
+        const t = setTimeout(() => { pending.delete(id); reject(new Error('the page did not answer (file-provider worker not running?)')); }, 4000);
+        pending.set(id, m => { clearTimeout(t); m.file ? resolve(m.file) : reject(new Error(m.error ?? 'file not found in storage')); });
+        chan.postMessage({ type: 'get', id, file: i });
+    });
+}
+async function openFile(i: number): Promise<File> {
+    if (directError === null) {
+        try { return await direct(i); } catch (e) { gameDir = null; directError = String(e); }
+    }
+    try { return await viaProvider(i); } catch (e) { throw new Error(`direct: ${directError}; via page: ${String(e)}`); }
+}
+export async function gameFetch(req: Request): Promise<Response> {
+    const g = await load();
+    const rel = relPath(new URL(req.url));
+    if (!g) { fail(rel, 'no game imported yet'); return new Response('no game imported yet', { status: 404 }); }
+    const i = g.lookup.find(rel);
+    if (i === undefined) { fail(rel, 'not in the imported game (404)'); return new Response('not found', { status: 404 }); }
+    let file: File;
+    try { file = await openFile(i); } catch (e) { fail(rel, 'storage read failed: ' + String(e)); return new Response('game storage is not available: ' + String(e), { status: 500 }); }
+    const ext = rel.slice(rel.lastIndexOf('.') + 1).toLowerCase();
+    const headers: Record<string, string> = { 'content-type': MIME[ext] ?? 'application/octet-stream', 'accept-ranges': 'bytes', 'cache-control': 'no-cache' };
+    const size = file.size;
+    const m = /^bytes=(\d*)-(\d*)$/.exec(req.headers.get('range') ?? '');
+    if (m && (m[1] || m[2])) {
+        const start = m[1] ? Number(m[1]) : Math.max(0, size - Number(m[2]));
+        const end = m[1] && m[2] ? Math.min(Number(m[2]), size - 1) : size - 1;
+        if (start > end || start >= size) return new Response(null, { status: 416, headers: { 'content-range': `bytes */${size}` } });
+        return new Response(req.method === 'HEAD' ? null : file.slice(start, end + 1), { status: 206, headers: { ...headers, 'content-range': `bytes ${start}-${end}/${size}`, 'content-length': String(end - start + 1) } });
+    }
+    return new Response(req.method === 'HEAD' ? null : file, { headers: { ...headers, 'content-length': String(size) } });
+}
+export async function specialRoute(req: Request, rel: string, url: URL): Promise<Response> {
+    switch (rel) {
+        case '__config': {
+            const g = await load();
+            return g ? Response.json({ key: g.key }) : new Response('no game imported yet', { status: 404 });
+        }
+        case '__ls': {
+            const names = (await load())?.lookup.list(url.searchParams.get('p') ?? '');
+            return names ? Response.json(names) : new Response(null, { status: 404 });
+        }
+        case '__diag': {
+            const g = await load();
+            const out: Record<string, unknown> = { hasGame: !!g, files: g?.count };
+            try { out.workerReadsStorageItself = { firstFileBytes: (await direct(0)).size }; } catch (e) { out.workerReadsStorageItself = 'threw ' + String(e); }
+            try { out.viaFileProvider = { firstFileBytes: (await viaProvider(0)).size }; } catch (e) { out.viaFileProvider = 'threw ' + String(e); }
+            return Response.json(out);
+        }
+        case '__failures': return Response.json([...failures].map(([path, why]) => `${path}: ${why}`));
+        default: return new Response('not found', { status: 404 });
+    }
+}

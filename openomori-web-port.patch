+export const BASE: string = typeof document === 'undefined' ? '/' : new URL('.', document.baseURI).pathname;
+if (typeof window !== 'undefined' && BASE !== '/') {
+    const rebase = (u: string) => (u.startsWith('/') && !u.startsWith('//') && !u.startsWith(BASE) ? BASE + u.slice(1) : u);
+    const realFetch = window.fetch.bind(window);
+    window.fetch = ((input: RequestInfo | URL, init?: RequestInit) => realFetch(typeof input === 'string' ? rebase(input) : input, init)) as typeof fetch;
+    const realOpen = XMLHttpRequest.prototype.open;
+    XMLHttpRequest.prototype.open = function (this: XMLHttpRequest, method: string, url: string | URL, ...rest: unknown[]) {
+        return (realOpen as (...a: unknown[]) => void).call(this, method, typeof url === 'string' ? rebase(url) : url, ...rest);
+    } as typeof XMLHttpRequest.prototype.open;
+}

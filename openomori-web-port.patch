+            const gr = groups.find(x => x.id === drag!.id)!, m = metrics(), s = draft[gr.id]!.s;
+            const [x, y] = clampPos(m, e.clientX - drag.dx, e.clientY - drag.dy, gr.half * s);
+            place(gr.id, x, y, s); layout();
+            return;
+        }
+        const o = owner.get(e.pointerId);
+        if (!o) return;
+        e.preventDefault();
+        if (o === 'pad') down.set(e.pointerId, padDirs(e.clientX, e.clientY));
+        else { const n = buttonAt(e.clientX, e.clientY); down.set(e.pointerId, n ? new Set([n]) : new Set()); }
+        apply();
+    });
+    const up = (e: PointerEvent) => {
+        if (drag && drag.pointer === e.pointerId) { drag = null; return; }
+        if (!owner.has(e.pointerId)) return;
+        e.preventDefault(); owner.delete(e.pointerId); down.delete(e.pointerId); apply();
+    };
+    root.addEventListener('pointerup', up);
+    root.addEventListener('pointercancel', up);
+    root.addEventListener('contextmenu', e => e.preventDefault());
+    for (const t of ['touchstart', 'touchmove', 'touchend', 'touchcancel', 'mousedown', 'mousemove', 'mouseup', 'click', 'wheel'])
+        root.addEventListener(t, e => e.stopPropagation(), { passive: true });
+    document.addEventListener('visibilitychange', () => { if (document.hidden) releaseAll(); });
+    const rot = document.createElement('div');
+    rot.id = 'omori-rotate';
+    rot.textContent = 'Please rotate your device';
+    document.body.append(rot);
+    const audio = (muted: boolean) => {
+        try { g.Howler?.mute?.(muted); } catch {  }
+        try { const c = g.WebAudio?._context as AudioContext | undefined; void (muted ? c?.suspend?.() : c?.resume?.()); } catch {  }
+        try { document.querySelectorAll('audio,video').forEach(m => { (m as HTMLMediaElement).muted = muted; }); } catch {  }
+    };
+    const update = () => {
+        layout();
+        const p = isPortrait();
+        if (p === portrait) return;
+        portrait = p;
+        document.documentElement.classList.toggle('omori-portrait', p);
+        if (p) { releaseAll(); closeEditor(false); }
+        audio(p);
+    };
+    addEventListener('resize', update);
+    addEventListener('orientationchange', () => { update(); setTimeout(update, 150); setTimeout(update, 500); });
+    update();
+    const hook = setInterval(() => {
+        const SM = g.SceneManager;
+        if (!SM?.updateScene || !SM._scene || !SM._sceneStarted) return;
+        clearInterval(hook);
+        const stock = SM.updateScene;
+        SM.updateScene = function (this: unknown, ...a: unknown[]) { if (!portrait && !editing) return stock.apply(this, a); };
+    }, 100);
+    lockOrientation();
+}

+import { getMeta, setMeta } from './idb.ts';
+import type { GameIndex } from './game-index.ts';
+const META = 'webGame';
+export const getGame = () => getMeta<GameIndex>(META);
+export const saveGame = (g: GameIndex) => setMeta(META, g);
+export async function gameIsIntact(): Promise<boolean> {
+    const g = await getGame().catch(() => undefined);
+    if (!g?.key || !g.files?.length) return false;
+    try {
+        const dir = await (await navigator.storage.getDirectory()).getDirectoryHandle('game');
+        await dir.getFileHandle('0');
+        return true;
+    } catch { return false; }
+}
+export async function removeGame(): Promise<void> {
+    await (await navigator.storage.getDirectory()).removeEntry('game', { recursive: true }).catch(() => {});
+    await setMeta(META, undefined);
+}
